{{!-- Password reset. Data: emails/password-reset.props.json. Never put the password itself in an email. --}}
<mj-section>
  <mj-column>
    <mj-text mj-class="h1"><h1 style="margin:0;font-size:30px;font-weight:400;">Reset your password</h1></mj-text>
    <mj-text>Hi {{user.firstName}}, we got a request to reset the password for your {{brand.name}} account. Choose a new one with the button below.</mj-text>
    {{> button url=resetUrl label="Choose a new password"}}
    {{> fallback-link url=resetUrl}}
  </mj-column>
</mj-section>
<mj-section padding="8px 36px">
  <mj-column mj-class="panel">
    <mj-text padding="16px 22px 2px" font-size="14px"><strong>Requested</strong> {{date request.at "datetime"}}</mj-text>
    <mj-text padding="2px 22px 16px" font-size="14px"><strong>From</strong> {{request.device}}, near {{request.location}}</mj-text>
  </mj-column>
</mj-section>
<mj-section>
  <mj-column>
    <mj-text mj-class="muted" padding="16px 36px 6px">The link expires in {{expiresInMinutes}} minutes and works once. If this wasn't you, ignore this email: your password stays the same. We'll never ask for your password by email.</mj-text>
    {{> sign-off}}
  </mj-column>
</mj-section>
